@LuminaBox.Api_HostAddress = http://localhost:5155
@accessToken = 
@refreshToken = 
@productId = 00000000-0000-0000-0000-000000000000
@categoryId = 00000000-0000-0000-0000-000000000000
@fillingId = 00000000-0000-0000-0000-000000000000
@boxItemId = 00000000-0000-0000-0000-000000000000
@cartItemId = 00000000-0000-0000-0000-000000000000
@voucherId = 00000000-0000-0000-0000-000000000000
@userVoucherId = 00000000-0000-0000-0000-000000000000
@orderId = 00000000-0000-0000-0000-000000000000
@paymentId = 00000000-0000-0000-0000-000000000000

### Register
POST {{LuminaBox.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "testuser@example.com",
  "password": "Password1!",
  "confirmPassword": "Password1!",
  "phone": "0901234567",
  "address": "123 Test Street"
}

### Verify OTP (replace otpCode from server log)
POST {{LuminaBox.Api_HostAddress}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "testuser@example.com",
  "otpCode": "000000"
}

### Login
POST {{LuminaBox.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Password1!"
}

### Get current user
GET {{LuminaBox.Api_HostAddress}}/api/users/me
Authorization: Bearer {{accessToken}}

### Update current user
PUT {{LuminaBox.Api_HostAddress}}/api/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Test User Updated",
  "phone": "0912345678",
  "address": "456 New Street"
}

### Logout
POST {{LuminaBox.Api_HostAddress}}/api/auth/logout
Authorization: Bearer {{accessToken}}

### ============================================================================
### VOUCHER ENDPOINTS
### ============================================================================

### Create platform voucher (Manager)
POST {{LuminaBox.Api_HostAddress}}/api/vouchers/platform
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "code": "MIDAUTUMN20",
  "name": "Giảm 20K toàn sàn",
  "description": "Áp dụng đơn từ 150.000đ",
  "discountType": "Fixed",
  "discountValue": 20000,
  "minOrderAmount": 150000,
  "usageLimit": 100,
  "usageLimitPerUser": 1,
  "startAt": "2026-11-01T00:00:00Z",
  "endAt": "2026-12-31T23:59:59Z"
}

### Create organizer voucher (Organization)
POST {{LuminaBox.Api_HostAddress}}/api/vouchers/organizer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "code": "SHOP10",
  "name": "Giảm 10% tại shop",
  "description": "Tối đa 50.000đ cho đơn từ 200.000đ",
  "discountType": "Percent",
  "discountValue": 10,
  "maxDiscountAmount": 50000,
  "minOrderAmount": 200000,
  "usageLimit": 50,
  "usageLimitPerUser": 1,
  "startAt": "2026-11-01T00:00:00Z",
  "endAt": "2026-12-31T23:59:59Z"
}

### Get available vouchers to claim (User)
GET {{LuminaBox.Api_HostAddress}}/api/vouchers/available
Authorization: Bearer {{accessToken}}

### Claim voucher into wallet (User)
POST {{LuminaBox.Api_HostAddress}}/api/vouchers/{{voucherId}}/claim
Authorization: Bearer {{accessToken}}

### Get my claimed vouchers (User)
GET {{LuminaBox.Api_HostAddress}}/api/vouchers/my
Authorization: Bearer {{accessToken}}

### Remove claimed voucher from wallet (User)
DELETE {{LuminaBox.Api_HostAddress}}/api/vouchers/my/{{userVoucherId}}
Authorization: Bearer {{accessToken}}

### ============================================================================
### CART ENDPOINTS
### ============================================================================

### Get my cart
GET {{LuminaBox.Api_HostAddress}}/api/carts/me
Authorization: Bearer {{accessToken}}

### Add product to cart (by ProductId + CategoryId + FillingId)
POST {{LuminaBox.Api_HostAddress}}/api/carts/items/product
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "categoryId": "{{categoryId}}",
  "fillingId": "{{fillingId}}",
  "quantity": 2
}

### Add box to cart
POST {{LuminaBox.Api_HostAddress}}/api/carts/items/box
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "boxItemId": "{{boxItemId}}",
  "quantity": 1
}

### Update cart item (partial update)
PUT {{LuminaBox.Api_HostAddress}}/api/carts/items/{{cartItemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "quantity": 3,
  "categoryId": "{{categoryId}}",
  "fillingId": "{{fillingId}}"
}

### Remove cart item
DELETE {{LuminaBox.Api_HostAddress}}/api/carts/items/{{cartItemId}}
Authorization: Bearer {{accessToken}}

### ============================================================================
### ORDER ENDPOINTS
### ============================================================================

### Create order directly (auto-maps buyer default shipping address)
POST {{LuminaBox.Api_HostAddress}}/api/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "paymentMethod": "Stripe",
  "note": "Giao giờ hành chính",
  "voucherIds": [
    "{{voucherId}}"
  ],
  "items": [
    {
      "itemType": "Product",
      "productId": "{{productId}}",
      "categoryId": "{{categoryId}}",
      "fillingId": "{{fillingId}}",
      "quantity": 2
    }
  ]
}

### Create order from cart (auto-maps buyer default shipping address)
POST {{LuminaBox.Api_HostAddress}}/api/orders/from-cart
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "paymentMethod": "CashOnDelivery",
  "voucherIds": [
    "{{voucherId}}"
  ],
  "cartItemIds": [
    "{{cartItemId}}"
  ]
}

### Get my orders
GET {{LuminaBox.Api_HostAddress}}/api/orders/me?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

### Get organizer orders
GET {{LuminaBox.Api_HostAddress}}/api/orders/organizer/me?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

### Get order detail
GET {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

### Confirm order (Organizer)
PUT {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}/confirm
Authorization: Bearer {{accessToken}}

### Ship order (Organizer)
PUT {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}/ship
Authorization: Bearer {{accessToken}}

### Mark order delivered (Organizer)
PUT {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}/mark-delivered
Authorization: Bearer {{accessToken}}

### Reject order (Organizer)
PUT {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}/reject
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Hết nguyên liệu làm bánh"
}

### Cancel order (Buyer or Organizer)
PUT {{LuminaBox.Api_HostAddress}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Đổi ý muốn chọn nhân khác"
}
